diff --git a/tests/httpcore2/test_http2_threading.py b/tests/httpcore2/test_http2_threading.py
new file mode 100644
index 0000000..ad79178
--- /dev/null
+++ b/tests/httpcore2/test_http2_threading.py
@@ -0,0 +1,53 @@
+import threading
+import time
+import typing
+
+import hyperframe.frame
+
+import httpcore2
+
+
+def test_concurrent_requests_use_unique_stream_ids(monkeypatch) -> None:
+    """
+    Regression test for a race between threads sharing an HTTP/2 connection.
+
+    `h2` only moves on to the next outbound stream ID once headers have been
+    sent on the current one, so allocating a stream ID and sending the request
+    headers has to be a single atomic operation. Otherwise several threads are
+    handed the same stream ID, and the connection (and the HPACK encoder state
+    that goes with it) is corrupted.
+
+    See https://github.com/pydantic/httpx2/issues/908
+    """
+    origin = httpcore2.Origin(b"https", b"example.com", 443)
+    network_stream = httpcore2.MockStream([hyperframe.frame.SettingsFrame().serialize()])
+    conn = httpcore2.HTTP2Connection(origin=origin, stream=network_stream)
+    request = httpcore2.Request("GET", "https://example.com/", headers={"Host": "example.com"})
+    conn._send_connection_init(request)
+
+    send_headers = conn._h2_state.send_headers
+
+    def slow_send_headers(*args: typing.Any, **kwargs: typing.Any) -> typing.Any:
+        # Widen the window between allocating a stream ID and sending the
+        # headers that consume it, so that an unsynchronized implementation
+        # reliably hands the same ID out more than once.
+        time.sleep(0.05)
+        return send_headers(*args, **kwargs)
+
+    monkeypatch.setattr(conn._h2_state, "send_headers", slow_send_headers)
+
+    stream_ids: list[int] = []
+    results_lock = threading.Lock()
+
+    def send_request_headers() -> None:
+        stream_id = conn._send_request_headers(request=request)
+        with results_lock:
+            stream_ids.append(stream_id)
+
+    threads = [threading.Thread(target=send_request_headers) for _ in range(4)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
+
+    assert sorted(stream_ids) == [1, 3, 5, 7]
